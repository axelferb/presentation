# Proposales API
# Get your API key from: https://secure.proposales.com/settings/profile
PROPOSALES_API_KEY=your_proposales_api_key_here

# Your Proposales Company ID (contact Proposales support if unsure)
PROPOSALES_COMPANY_ID=your_company_id_here

# Anthropic API key — used by the Vercel AI SDK (@ai-sdk/anthropic)
# Get yours from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
