# Proposales API
# Get your API key from: https://secure.proposales.com/settings/profile
PROPOSALES_API_KEY=your_proposales_api_key_here

# Your Proposales Company ID
# Find it by running: curl -H "Authorization: Bearer YOUR_PROPOSALES_API_KEY" https://api.proposales.com/v1/companies
PROPOSALES_COMPANY_ID=your_company_id_here

# Google Gemini API key (free — no credit card needed)
# Get yours at: https://aistudio.google.com → "Get API Key"
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here
